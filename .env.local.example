NEXT_PUBLIC_FIGMA_CLIENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, only used later for AI insights. Leave blank for the MVP.
OPENAI_API_KEY=

# Optional. Server-only (never exposed to the browser) — a Figma personal
# access token with read access to the prototype files used in your tests.
# Used only to resolve node IDs to human-readable screen names in the A/B
# results dashboard. Leave blank to fall back to "Screen 1", "Screen 2", etc.
FIGMA_ACCESS_TOKEN=

# Optional — powers the on-demand "Generate AI Insights" button on results
# pages via a local, OpenAI-compatible chat-completions endpoint (e.g. LM
# Studio, llama.cpp server, MLX). Leave blank to disable that button; no
# data is ever sent to a third-party API. Defaults shown are an example.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
